# Integrações de leitura
MONDAY_API_TOKEN=
GEMINI_API_KEY=
GOOGLE_CALENDAR_ICAL_URL=

# Scraper do Instagram — nunca versionar cookies reais.
# Produção: use o JSON compacto na variável protegida da Vercel.
INSTAGRAM_COOKIES_JSON=
# Desenvolvimento: caminho opcional para um arquivo local ignorado pelo Git.
INSTAGRAM_COOKIES_PATH=

# Transparência por link
# A leitura executiva é pública para quem possui o link. Não há login ou perfis.
# O token abaixo é somente técnico para escritas administrativas e automações.
NEXUS_ADMIN_TOKEN=
# Origens permitidas em produção, separadas por vírgula.
NEXUS_ALLOWED_ORIGINS=https://vybe-nexus.vercel.app
NEXUS_RATE_LIMIT_WINDOW_MS=60000
NEXUS_RATE_LIMIT_MAX=120
NEXUS_ADMIN_RATE_LIMIT_WINDOW_MS=60000
NEXUS_ADMIN_RATE_LIMIT_MAX=30

# Persistência executiva — Upstash Redis REST ou Vercel/Upstash KV.
# O URL deve ser HTTPS e o token padrão nunca pode ser exposto no frontend.
# É possível usar um único store compartilhado:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Ou URLs/tokens específicos por domínio:
NEXUS_DECISION_STORE_URL=
NEXUS_DECISION_STORE_TOKEN=
NEXUS_SNAPSHOT_STORE_URL=
NEXUS_SNAPSHOT_STORE_TOKEN=
NEXUS_IMPACT_STORE_URL=
NEXUS_IMPACT_STORE_TOKEN=
NEXUS_HEALTH_STORE_URL=
NEXUS_HEALTH_STORE_TOKEN=
NEXUS_STORE_URL=
NEXUS_STORE_TOKEN=
NEXUS_STORE_PREFIX=vybe:nexus
NEXUS_STORE_RETENTION_ENABLED=true
NEXUS_STORE_RETENTION_DAYS=180
NEXUS_STORE_MAX_RECORDS=5000
# Desenvolvimento/local: permite autosave e leitura em .data.
# Em produção, vazio significa: autosave automático somente quando o datastore estiver pronto.
# Use false para desativar explicitamente ou true para exigir a tentativa de gravação.
NEXUS_LOCAL_DATA_DIR=.data
NEXUS_SNAPSHOT_AUTOSAVE=
NEXUS_HEALTH_AUTOSAVE=
NEXUS_HEALTH_HEALTHY_THRESHOLD=75
NEXUS_HEALTH_ATTENTION_THRESHOLD=50

# Release: usado para validar a origem do SHA retornado por /api/healthz.
NEXUS_EXPECTED_GIT_REPOSITORY=Vybebrasil/vybe-monitorado

# Vybe Painel — proxy GraphQL opcional, somente leitura.
# Por padrão usa https://vybepainel-v2.vercel.app/api/monday.
# Ative a integração na camada executiva somente após validar o contrato do Painel.
VYBE_PANEL_API_URL=https://vybepainel-v2.vercel.app/api/monday
VYBE_PANEL_API_VERSION=2024-01
VYBE_PANEL_API_TOKEN=

# KPI de calendário: informe exatamente três IDs de colunas mensais do board Gestão de Clientes.
# Sem esta configuração, o KPI aparece como N/D e explica que o campo não está mapeado.
MONDAY_CALENDAR_MONTH_COLUMN_IDS=
